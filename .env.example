# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# DATABASE CONFIGURATION (Vercel serverless / PostgreSQL)
# Required ONLY when deployed to Vercel or testing database sync.
# Leave blank for lightweight local storage JSON-fallback.
POSTGRES_URL="postgres://default:password@ep-cool-cloud-123456.ap-southeast-1.postgres.vercel-storage.com:5432/verceldb?sslmode=require"

# JWT SIGNING KEY (Use at least 32 characters)
JWT_SECRET="pointone_super_secret_key_65_singapore_ceiling_fans"
